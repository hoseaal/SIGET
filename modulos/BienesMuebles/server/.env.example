# Configuracion del modulo Bienes Muebles
# Copia este archivo como .env y ajusta los valores reales.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=dbsiget

# Seguridad (JWT)
SECRET_KEY=cambia_esto_por_una_clave_de_al_menos_32_caracteres

# Integracion con el modulo de Soporte Tecnico
# Debe coincidir con BIENES_API_KEY del modulo Soporte Tecnico.
SOPORTE_API_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Servidor
PORT=5001
NODE_ENV=development
